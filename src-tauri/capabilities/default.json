{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: fullscreen toggle, the save-data store, updates (check, install, restart) and opening a web link.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "store:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "opener:default"
  ]
}
